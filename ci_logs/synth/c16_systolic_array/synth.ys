chtype -set c16_mac_pe t:mac_pe r:IW=2 %i r:KSN=33024 %i r:NB=4 %i r:NH=16 %i r:NL=9 %i r:WL=0 %i r:WW=8 %i
chtype -set c16_mac_pe_chk t:mac_pe r:IW=0 %i r:KSN=1064960 %i r:NB=1 %i r:NH=15 %i r:NL=15 %i r:WL=6 %i r:WW=13 %i
