# generic synthesis (the children and the leaves stay black boxes); the arithmetic as the ORFS flow maps it: Booth
# multipliers, Kogge-Stone carry lookahead, the full adders on the library's FA / HA cells
synth -top neo_top -booth -noabc -extra-map /home/runner/neo-synth/pdk/lib/common/lcu_kogge_stone.v
tee -q -o generic_stat.json stat -json
tee -q -o check.txt check
extract_fa
techmap -map /home/runner/neo-synth/pdk/lib/asap7/cells_adders.v
techmap
opt -fast -purge
# the flops named after the registers they hold (the paths read in RTL terms), then the library: flops, then ABC's
# speed script at the clock period with the driver / load of the platform
rename -wire -suffix _reg t:$_DFF* t:$_DFFE* t:$_SDFF* t:$_SDFFE* t:$_DFFSR* t:$_DFFSRE* t:$_ALDFF* t:$_DLATCH*
dfflibmap -liberty /home/runner/neo-synth/pdk/lib/asap7/asap7sc7p5t_SEQ_RVT_SS_nldm_220123.lib -dont_use *x1p*_ASAP7* -dont_use *xp*_ASAP7* -dont_use SDF* -dont_use ICG*
opt
setundef -zero
abc -script /home/runner/work/Astracore-Neo/Astracore-Neo/synth/abc_speed.script -liberty /home/runner/neo-synth/pdk/lib/asap7/asap7sc7p5t_AO_RVT_SS_nldm_211120.lib -liberty /home/runner/neo-synth/pdk/lib/asap7/asap7sc7p5t_INVBUF_RVT_SS_nldm_220122.lib -liberty /home/runner/neo-synth/pdk/lib/asap7/asap7sc7p5t_OA_RVT_SS_nldm_211120.lib -liberty /home/runner/neo-synth/pdk/lib/asap7/asap7sc7p5t_SIMPLE_RVT_SS_nldm_211120.lib -liberty /home/runner/neo-synth/pdk/lib/asap7/asap7sc7p5t_SEQ_RVT_SS_nldm_220123.lib -dont_use *x1p*_ASAP7* -dont_use *xp*_ASAP7* -dont_use SDF* -dont_use ICG* -D 500 -constr abc.constr
opt_clean -purge
# the library cells as black boxes, so the JSON carries every pin's direction (the repeater trees need it)
