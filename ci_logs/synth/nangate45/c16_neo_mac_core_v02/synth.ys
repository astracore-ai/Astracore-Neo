plugin -i slang
read_slang --ignore-timing --blackboxed-module neo_mac_core --blackboxed-module act_feeder --blackboxed-module acc_bank --blackboxed-module neo_icg --top neo_mac_core_v02 -G ROWS=16 -G COLS=8 -G XW=8 -G WW=8 -G PW=32 -G WCW=13 -G ACC_ROWS=64 -G ABUF_DEPTH=256 -G IDXW=6 -G AW=8 -G NCHK=4 /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_icg.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_iso.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/tile_telem.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/delay_line.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/mac_pe.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/skew_in.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/deskew_out.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/systolic_array.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/abft_checker.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_mem.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_mac_core.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/act_feeder.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/acc_bank.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_mac_core_v02.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/core_seq.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/ecc39.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/wbuf_mem.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/requant.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/vec_unit.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_core.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/host_if.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/noc_router.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/sram_bank.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/mbist.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/bank_bist_wrap.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/crc16_word.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/crc16_beat.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/tile_nic.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/tile_dma.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/prog_mem.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/esm.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/link_pack.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_tile.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/cdc_bits.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/cdc_fifo.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/cdc_sync.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/noc_axi_bridge.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/top_ctrl.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/mesh_ctrl.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_top.sv
read_verilog -lib stubs.v
chtype -set c16_acc_bank t:acc_bank 
setparam -unset ACC_ROWS -unset COLS -unset IDXW -unset PW -unset RW t:c16_acc_bank
chtype -set c16_neo_mac_core t:neo_mac_core 
setparam -unset COLS -unset CT -unset FAULT_COL -unset FAULT_ROW -unset IW -unset LATENCY -unset NB -unset NCHK -unset PE_LAT -unset PW -unset ROWS -unset WCW -unset WW -unset XB -unset XW -unset j -unset r t:c16_neo_mac_core
chtype -set c16_act_feeder t:act_feeder 
setparam -unset ABUF_DEPTH -unset AW -unset BWD -unset DWP -unset EWB -unset IDXW -unset NCHK -unset ND -unset ROWS -unset XB -unset XW -unset c -unset k -unset u t:c16_act_feeder
rename -top c16_neo_mac_core_v02
# generic synthesis (the children and the leaves stay black boxes); the arithmetic as the ORFS flow maps it: Booth
# multipliers, Kogge-Stone carry lookahead, the full adders on the library's FA / HA cells
synth -top c16_neo_mac_core_v02 -booth -noabc -extra-map /home/runner/neo-synth/pdk/lib/common/lcu_kogge_stone.v
tee -q -o generic_stat.json stat -json
tee -q -o check.txt check
extract_fa
techmap -map /home/runner/neo-synth/pdk/lib/nangate45/cells_adders.v
techmap
opt -fast -purge
# the flops named after the registers they hold (the paths read in RTL terms), then the library: flops, then ABC's
# speed script at the clock period with the driver / load of the platform
rename -wire -suffix _reg t:$_DFF* t:$_DFFE* t:$_SDFF* t:$_SDFFE* t:$_DFFSR* t:$_DFFSRE* t:$_ALDFF* t:$_DLATCH*
dfflibmap -liberty /home/runner/neo-synth/pdk/lib/nangate45/NangateOpenCellLibrary_typical.lib -dont_use TAPCELL_X1 -dont_use FILLCELL_X1 -dont_use AOI211_X1 -dont_use OAI211_X1
opt
setundef -zero
abc -script /home/runner/work/Astracore-Neo/Astracore-Neo/synth/abc_speed.script -liberty /home/runner/neo-synth/pdk/lib/nangate45/NangateOpenCellLibrary_typical.lib -dont_use TAPCELL_X1 -dont_use FILLCELL_X1 -dont_use AOI211_X1 -dont_use OAI211_X1 -D 500 -constr abc.constr
opt_clean -purge
# the library cells as black boxes, so the JSON carries every pin's direction (the repeater trees need it)
read_liberty -lib /home/runner/neo-synth/pdk/lib/nangate45/NangateOpenCellLibrary_typical.lib
tee -q -o stat.json stat -liberty /home/runner/neo-synth/pdk/lib/nangate45/NangateOpenCellLibrary_typical.lib -json
tee -q -o stat.txt stat -liberty /home/runner/neo-synth/pdk/lib/nangate45/NangateOpenCellLibrary_typical.lib
write_verilog -noattr -noexpr -nohex -nodec netlist.v
write_json netlist.json
