# unit tile_nic: tile_nic {'XW': 3, 'YW': 3, 'NX': 8, 'NSRC': 64, 'BW': 16, 'ROWS': 32, 'COLS': 32, 'WCW': 14, 'IDXW': 9, 'AW': 11, 'WAW': 10, 'BAW': 19, 'PW': 32, 'NCHK': 4, 'DFD': 512, 'FETCH_TIMEOUT': 1048575, 'DV_HOOKS': 0}
plugin -i slang
read_slang --ignore-timing --blackboxed-module neo_mem_rf --blackboxed-module neo_icg --top tile_nic -G XW=3 -G YW=3 -G NX=8 -G NSRC=64 -G BW=16 -G ROWS=32 -G COLS=32 -G WCW=14 -G IDXW=9 -G AW=11 -G WAW=10 -G BAW=19 -G PW=32 -G NCHK=4 -G DFD=512 -G FETCH_TIMEOUT=1048575 -G DV_HOOKS=0 /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_icg.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_iso.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/tile_telem.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/delay_line.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/mac_pe.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/skew_in.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/deskew_out.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/systolic_array.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/abft_checker.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_mem.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_mac_core.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/act_feeder.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/acc_bank.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_mac_core_v02.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/core_seq.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/ecc39.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/wbuf_mem.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/requant.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/vec_unit.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_core.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/host_if.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/noc_router.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/sram_bank.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/mbist.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/bank_bist_wrap.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/crc16_word.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/crc16_beat.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/tile_nic.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/tile_dma.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/prog_mem.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/esm.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/link_pack.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_tile.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/cdc_bits.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/cdc_fifo.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/cdc_sync.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/noc_axi_bridge.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/top_ctrl.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/mesh_ctrl.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_top.sv
read_verilog -lib stubs.v
chtype -set neo_mem_rf_w1068_d512_g1_rb1 t:neo_mem_rf r:AW=9 %i r:D=512 %i r:G=1 %i r:GW=1068 %i r:RB=1 %i r:W=1068 %i
chtype -set neo_mem_rf_w1024_d64_g32_rb0 t:neo_mem_rf r:AW=6 %i r:D=64 %i r:G=32 %i r:GW=32 %i r:RB=0 %i r:W=1024 %i
setparam -unset AW -unset D -unset DV_HOOKS -unset G -unset GW -unset RB -unset RBQ -unset W t:neo_mem_rf_w1024_d64_g32_rb0
setparam -unset AW -unset D -unset DV_HOOKS -unset G -unset GW -unset RB -unset RBQ -unset W t:neo_mem_rf_w1068_d512_g1_rb1
# generic synthesis (the children and the leaves stay black boxes); the arithmetic as the ORFS flow maps it: Booth
# multipliers, Kogge-Stone carry lookahead, the full adders on the library's FA / HA cells
synth -top tile_nic -booth -noabc -extra-map /home/runner/neo-synth/pdk/lib/common/lcu_kogge_stone.v
tee -q -o generic_stat.json stat -json
tee -q -o check.txt check
extract_fa
techmap -map /home/runner/neo-synth/pdk/lib/nangate45/cells_adders.v
techmap
opt -fast -purge
# the flops named after the registers they hold (the paths read in RTL terms), then the library: flops, then ABC's
# speed script at the clock period with the driver / load of the platform
rename -wire -suffix _reg t:$_DFF* t:$_DFFE* t:$_SDFF* t:$_SDFFE* t:$_DFFSR* t:$_DFFSRE* t:$_ALDFF* t:$_DLATCH*
dfflibmap -liberty /home/runner/neo-synth/pdk/lib/nangate45/NangateOpenCellLibrary_typical.lib -dont_use TAPCELL_X1 -dont_use FILLCELL_X1 -dont_use AOI211_X1 -dont_use OAI211_X1
opt
setundef -zero
abc -script /home/runner/work/Astracore-Neo/Astracore-Neo/synth/abc_speed.script -liberty /home/runner/neo-synth/pdk/lib/nangate45/NangateOpenCellLibrary_typical.lib -dont_use TAPCELL_X1 -dont_use FILLCELL_X1 -dont_use AOI211_X1 -dont_use OAI211_X1 -D 500 -constr abc.constr
opt_clean -purge
# the library cells as black boxes, so the JSON carries every pin's direction (the repeater trees need it)
read_liberty -lib /home/runner/neo-synth/pdk/lib/nangate45/NangateOpenCellLibrary_typical.lib
# the clock gates onto the library's integrated clock-gating cell (drop 0.43)
techmap -map icg_map.v
opt_clean
tee -q -o stat.json stat -liberty /home/runner/neo-synth/pdk/lib/nangate45/NangateOpenCellLibrary_typical.lib -json
tee -q -o stat.txt stat -liberty /home/runner/neo-synth/pdk/lib/nangate45/NangateOpenCellLibrary_typical.lib
write_verilog -noattr -noexpr -nohex -nodec netlist.v
write_json netlist.json
