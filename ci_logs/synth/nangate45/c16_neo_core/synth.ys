plugin -i slang
read_slang --ignore-timing --blackboxed-module neo_mac_core_v02 --blackboxed-module wbuf_mem --blackboxed-module requant --blackboxed-module core_seq --blackboxed-module vec_unit --blackboxed-module neo_icg --top neo_core -G ROWS=16 -G COLS=8 -G PW=32 -G ACC_ROWS=64 -G ABUF_DEPTH=256 -G WBUF_DEPTH=512 -G NCHK=4 -G DV_HOOKS=0 /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_icg.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_iso.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/tile_telem.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/delay_line.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/mac_pe.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/skew_in.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/deskew_out.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/systolic_array.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/abft_checker.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_mem.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_mac_core.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/act_feeder.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/acc_bank.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_mac_core_v02.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/core_seq.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/ecc39.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/wbuf_mem.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/requant.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/vec_unit.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_core.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/host_if.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/noc_router.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/sram_bank.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/mbist.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/bank_bist_wrap.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/crc16_word.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/crc16_beat.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/tile_nic.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/tile_dma.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/prog_mem.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/esm.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/link_pack.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_tile.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/cdc_bits.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/cdc_fifo.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/cdc_sync.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/noc_axi_bridge.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/top_ctrl.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/mesh_ctrl.sv /home/runner/work/Astracore-Neo/Astracore-Neo/rtl/neo_top.sv
read_verilog -lib stubs.v
chtype -set c16_neo_mac_core_v02 t:neo_mac_core_v02 
setparam -unset ABUF_DEPTH -unset ACC_ROWS -unset AW -unset COLS -unset FAULT_COL -unset FAULT_ROW -unset IDXW -unset IW -unset LATENCY -unset NCHK -unset PE_LAT -unset PW -unset ROWS -unset WCW -unset WW -unset XB -unset XW t:c16_neo_mac_core_v02
chtype -set c16_requant t:requant 
setparam -unset BW -unset COLS -unset CTW -unset CW -unset MW -unset NC -unset NIN -unset NROW -unset PW -unset QI -unset SW -unset j t:c16_requant
chtype -set c16_core_seq t:core_seq 
setparam -unset COLS -unset IDXW -unset LAT -unset PE_LAT -unset ROWS -unset S_DONE -unset S_DRAIN -unset S_IDLE -unset S_LOAD0 -unset S_REDUCE -unset S_RUN -unset S_START -unset S_WAIT -unset WAW -unset WBUF_DEPTH t:c16_core_seq
chtype -set c16_vec_unit t:vec_unit 
setparam -unset ACC_ROWS -unset COLS -unset IDXW -unset LV -unset NP -unset NS -unset NST -unset OP_ADDR -unset OP_BMUL -unset OP_BSUB -unset OP_CLAMP -unset OP_EMIT -unset OP_END -unset OP_LUT -unset OP_MULS -unset OP_RED -unset OP_RLD -unset OP_RSST -unset OP_SALU -unset OP_SLD -unset OP_SLUT -unset OP_SMUL -unset OP_SQR -unset PW -unset RBW -unset RCY -unset ROWS -unset TW -unset c -unset j t:c16_vec_unit
chtype -set c16_wbuf_mem t:wbuf_mem 
setparam -unset COLS -unset CW -unset DEPTH -unset DV_HOOKS -unset EW -unset EWC -unset IDX0 -unset IW -unset LANES -unset NCHK -unset PW_ -unset WAW -unset WCW -unset WW -unset l t:c16_wbuf_mem
rename -top c16_neo_core
# generic synthesis (the children and the leaves stay black boxes); the arithmetic as the ORFS flow maps it: Booth
# multipliers, Kogge-Stone carry lookahead, the full adders on the library's FA / HA cells
synth -top c16_neo_core -booth -noabc -extra-map /home/runner/neo-synth/pdk/lib/common/lcu_kogge_stone.v
tee -q -o generic_stat.json stat -json
tee -q -o check.txt check
extract_fa
techmap -map /home/runner/neo-synth/pdk/lib/nangate45/cells_adders.v
techmap
opt -fast -purge
# the flops named after the registers they hold (the paths read in RTL terms), then the library: flops, then ABC's
# speed script at the clock period with the driver / load of the platform
rename -wire -suffix _reg t:$_DFF* t:$_DFFE* t:$_SDFF* t:$_SDFFE* t:$_DFFSR* t:$_DFFSRE* t:$_ALDFF* t:$_DLATCH*
dfflibmap -liberty /home/runner/neo-synth/pdk/lib/nangate45/NangateOpenCellLibrary_typical.lib -dont_use TAPCELL_X1 -dont_use FILLCELL_X1 -dont_use AOI211_X1 -dont_use OAI211_X1
opt
setundef -zero
abc -script /home/runner/work/Astracore-Neo/Astracore-Neo/synth/abc_speed.script -liberty /home/runner/neo-synth/pdk/lib/nangate45/NangateOpenCellLibrary_typical.lib -dont_use TAPCELL_X1 -dont_use FILLCELL_X1 -dont_use AOI211_X1 -dont_use OAI211_X1 -D 500 -constr abc.constr
opt_clean -purge
# the library cells as black boxes, so the JSON carries every pin's direction (the repeater trees need it)
read_liberty -lib /home/runner/neo-synth/pdk/lib/nangate45/NangateOpenCellLibrary_typical.lib
# the clock gates onto the library's integrated clock-gating cell (drop 0.43)
techmap -map icg_map.v
opt_clean
tee -q -o stat.json stat -liberty /home/runner/neo-synth/pdk/lib/nangate45/NangateOpenCellLibrary_typical.lib -json
tee -q -o stat.txt stat -liberty /home/runner/neo-synth/pdk/lib/nangate45/NangateOpenCellLibrary_typical.lib
write_verilog -noattr -noexpr -nohex -nodec netlist.v
write_json netlist.json
