# abft_checker -- a row's verdict two cycles after valid: err == (row sum != y_chk) with err_valid; err_sticky after err
# COLS = 4, PW = 8, every input free; the sum wraps at PW bits (formed in the harness as a tree, the RTL as carry-save
# rows and a carry-free compare); err_valid is valid delayed by two, err never without err_valid; err_sticky sets the
# cycle after err, holds, clears on abft_clear. Full proof by k-induction (drop 0.41, the two-stage checker);
# abft_checker_fv.sv holds the harness.
[options]
mode prove
depth 2

[engines]
smtbmc yices

[script]
plugin -i slang
read_slang -DFORMAL --top abft_checker_fv abft_checker.sv abft_checker_fv.sv
prep -top abft_checker_fv

[files]
rtl/abft_checker.sv
formal/abft_checker_fv.sv
